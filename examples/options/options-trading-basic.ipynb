# 1. إدخال بيانات حسابك (ضع مفاتيحك هنا)
API_KEY = "https://paper-api.alpaca.markets/v2"
SECRET_KEY = "PKUM7UQ6P5RLPS4472BQBD2YE7"

import os
from alpaca.trading.client import TradingClient
from alpaca.trading.requests import GetAssetsRequest, GetOptionContractsRequest
from alpaca.trading.enums import AssetStatus

# الاتصال بالحساب التجريبي
trade_client = TradingClient(api_key=API_KEY, secret_key=SECRET_KEY, paper=True)

# 2. البحث عن أفضل الأسهم التي تدعم الخيارات
# (ملاحظة: هنا نأخذ عينة، ويمكن تطويرها لفرز الأكثر ارتفاعاً سعرياً)
search_params = GetAssetsRequest(attributes="options_enabled")
assets = trade_client.get_all_assets(search_params)

# لنأخذ أول 10 أسهم كمثال للمسح
top_10 = assets[:10]

print(f"جاري مسح أفضل {len(top_10)} أسهم واختيار أفضل عقدين لكل منها...\n")

for asset in top_10:
    # 3. طلب عقود الخيارات لهذا السهم
    contract_req = GetOptionContractsRequest(
        underlying_symbols=[asset.symbol],
        status=AssetStatus.ACTIVE,
        limit=20 # نطلب 20 عقد لنختار الأفضل منهم
    )
    
    try:
        contracts_res = trade_client.get_option_contracts(contract_req)
        contracts = contracts_res.option_contracts
        
        # ترتيب العقود حسب "الاهتمام المفتوح" (السيولة) واختيار أفضل 2
        best_2 = sorted(contracts, key=lambda c: int(c.open_interest if c.open_interest else 0), reverse=True)[:2]
        
        print(f"📌 السهم: {asset.symbol}")
        for i, c in enumerate(best_2):
            print(f"   [{i+1}] عقد: {c.symbol} | تنفيذ: {c.strike_price}$ | ينتهي في: {c.expiration_date}")
        print("-" * 30)
        
    except Exception as e:
        continue
